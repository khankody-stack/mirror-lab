{
  "name": "mirror-lab",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "LEADERBOARD",
        "class_name": "Leaderboard"
      }
    ]
  },
  "migrations": [
    {
      "tag": "leaderboard-v1",
      "new_sqlite_classes": [
        "Leaderboard"
      ]
    }
  ]
}
